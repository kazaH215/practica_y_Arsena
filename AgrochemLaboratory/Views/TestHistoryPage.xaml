<Page x:Class="AgrochemLaboratory.Views.TestHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История испытаний" Background="{StaticResource BackgroundDark}" Height="539" Width="1080">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📜 История испытаний" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Все проведённые лабораторные испытания" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="32"/>
                <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" Width="90" Height="32" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="⏳ Загрузка данных..." HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Tests}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectedItem="{Binding SelectedTest}"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibility}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="200"/>
                <DataGridTextColumn Header="№ партии" Binding="{Binding ObjectNumber}" Width="120"/>
                <DataGridTextColumn Header="Тип испытания" Binding="{Binding TestType}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="30"
                Visibility="{Binding HasNoData, Converter={StaticResource BooleanToVisibility}}" Margin="0,168,0,0">
            <TextBlock Text="📭 Нет данных об испытаниях" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15" Margin="0,189,0,0"
                BorderBrush="#3F3F55" BorderThickness="1">
            <Button Content="📋 Детали" Command="{Binding ViewDetailsCommand}" 
                    Width="100" Height="34" Style="{StaticResource PrimaryButton}"/>
        </Border>
    </Grid>
</Page>