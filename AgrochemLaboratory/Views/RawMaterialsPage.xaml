<Page x:Class="AgrochemLaboratory.Views.RawMaterialsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Партии сырья" Background="{StaticResource BackgroundDark}" Height="1054" Width="1200">

    <Grid Margin="25,25,25,280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Партии сырья" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Сырьё, ожидающее лабораторного анализа" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="32"/>
                <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" Width="122" Height="32" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="⏳ Загрузка данных..." HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding RawMaterials}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectedItem="{Binding SelectedMaterial}"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibility}}" Margin="0,0,0,243">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding Number}" Width="130"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="150"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"/>
                <DataGridTemplateColumn Header="Статус" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="20" Padding="8,4" Background="{Binding CurrentStatus, Converter={StaticResource StatusToColor}}">
                                <TextBlock Text="{Binding CurrentStatus}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="30"
                Visibility="{Binding HasNoData, Converter={StaticResource BooleanToVisibility}}" Margin="0,289,0,0">
            <TextBlock Text="📭 Нет партий сырья, ожидающих анализа" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15"
                BorderBrush="#3F3F55" BorderThickness="1" Height="243" VerticalAlignment="Top" Margin="0,299,0,0">
            <Button Content="🔬 Начать испытание" Command="{Binding StartTestCommand}" 
                    Width="160" Height="34" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding SelectedMaterial, Converter={StaticResource ObjectToBoolean}}"/>
        </Border>
    </Grid>
</Page>