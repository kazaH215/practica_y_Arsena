<Page x:Class="AgrochemLaboratory.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель управления" Background="{StaticResource BackgroundDark}">

    <ScrollViewer>
        <StackPanel Margin="25">
            <TextBlock Text="📊 Панель управления лаборатории" FontSize="24" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
            <TextBlock Text="Сводка по испытаниям и контролю качества" FontSize="14" 
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,25"/>

            <WrapPanel x:Name="StatsPanel" Margin="0,0,0,30"/>

            <TextBlock Text="📋 Последние испытания" FontSize="16" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="0" 
                    BorderBrush="#3F3F55" BorderThickness="1">
                <ListBox x:Name="EventsList" Height="220" BorderThickness="0" Padding="8"
                         Background="Transparent" Foreground="{StaticResource TextSecondary}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,6" FontSize="12"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="LoadingText" Text="⏳ Загрузка данных..." 
                       Foreground="{StaticResource TextSecondary}" FontSize="13" 
                       HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>