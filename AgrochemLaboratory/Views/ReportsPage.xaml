<Page x:Class="AgrochemLaboratory.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты" Background="{StaticResource BackgroundDark}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="📊 Отчёты" FontSize="28" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Формирование аналитических отчётов по лабораторным данным" 
                       FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Карточка параметров -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" CornerRadius="16" 
                Padding="25" Margin="0,0,0,25" BorderBrush="#3F3F55" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                
                <!-- Тип отчёта -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="📄 Тип отчёта" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding ReportTypes}" 
                              SelectedItem="{Binding SelectedReportType}" 
                              Background="{StaticResource SurfaceColor}" 
                              Foreground="{StaticResource TextPrimary}"
                              BorderBrush="#4B5563" Height="38" FontSize="14">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D3F"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F1F5F9"/>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>

                <!-- Период -->
                <StackPanel Grid.Row="1" Margin="0,0,0,25">
                    <TextBlock Text="📅 Период" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="10,5" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="С:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Width="140" 
                                            Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                            BorderBrush="#4B5563"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="По:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Width="140"
                                            Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                            BorderBrush="#4B5563"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding GenerateExcelCommand}" Width="140" Height="42" Margin="0,0,15,0"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📎" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Excel" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GeneratePdfCommand}" Width="140" Height="42"
                            Style="{StaticResource SecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="PDF" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceColor}" CornerRadius="16" Padding="20" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="Формирование отчёта..." Foreground="{StaticResource TextSecondary}" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>