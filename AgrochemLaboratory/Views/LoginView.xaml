<Window x:Class="AgrochemLaboratory.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агрохим · Лаборатория" Height="624" Width="665"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundDark}">

    <Window.Resources>
        <Style x:Key="LoginTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"/>
        <Style x:Key="LoginButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
    </Window.Resources>

    <Grid Margin="0,0,10,11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель (градиент) -->
        <Border Grid.Column="0" Background="#0F172A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <TextBlock Text="🔬" FontSize="64" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Center"/>
                <TextBlock Text="АГРОХИМ" FontSize="28" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <TextBlock Text="Лаборатория контроля качества" FontSize="14" 
                           Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <Line X1="0" Y1="0" X2="200" Y2="0" Stroke="#334155" StrokeThickness="1" 
                      Margin="0,30,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Лаборант" FontSize="16" Foreground="{StaticResource PrimaryLight}" 
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Правая панель (форма входа) -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceColor}" CornerRadius="20" Margin="20,20,10,0">
            <Grid Margin="25,35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TitleText" Text="Вход в систему" 
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" 
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Grid.Row="1" Text="Логин" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                <TextBox Grid.Row="2" x:Name="txtUsername" Style="{StaticResource LoginTextBox}"/>

                <TextBlock Grid.Row="3" Text="Пароль" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,15,0,5"/>
                <PasswordBox Grid.Row="4" x:Name="txtPassword" Style="{StaticResource LoginPasswordBox}"/>

                <!-- Captcha панель -->
                <StackPanel Grid.Row="5" x:Name="CaptchaPanel" Margin="0,15,0,0">
                    <TextBlock Text="Captcha" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtCaptchaCode" Text="1234" FontSize="18" FontWeight="Bold"
                                   Background="#252536" Padding="15,10" Margin="0,0,10,0" Foreground="{StaticResource TextPrimary}"/>
                        <TextBox x:Name="txtCaptcha" Width="100" Height="35" VerticalAlignment="Center"
                                 FontSize="14" TextAlignment="Center"/>
                        <Button Content="⟳" Width="40" Height="35" Margin="10,0" VerticalAlignment="Center"
                                Background="#3F3F55" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                Click="BtnRefreshCaptcha_Click" FontSize="16" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="6" x:Name="lblError" Foreground="#EF4444" FontSize="12" 
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,15,0,0"/>

                <Button Grid.Row="7" x:Name="btnLogin" Content="ВОЙТИ" Style="{StaticResource LoginButton}" 
                        Margin="0,20,0,10" Click="BtnLogin_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>