<Window x:Class="AgrochemLaboratory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агрохим · Лаборатория" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BackgroundDark}">

    <Window.Resources>
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F55"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSideMenuButton" TargetType="Button" BasedOn="{StaticResource SideMenuButton}">
            <Setter Property="Background" Value="#3F3F55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccent}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель (тёмная) -->
        <Border Grid.Column="0" Background="#1E1E2E" BorderBrush="#2D2D3F" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Border Grid.Row="0" Padding="0,30" Background="#181826">
                    <StackPanel>
                        <TextBlock Text="🔬" FontSize="40" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="АГРОХИМ" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,5"/>
                        <TextBlock Text="лаборатория" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                
                
                <!-- Меню -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0">
                    <StackPanel>
                        <Button x:Name="btnDashboard" Click="Dashboard_Click" Style="{StaticResource ActiveSideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="18" Width="28"/>
                                <TextBlock Text="Панель управления" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnRawMaterials" Click="RawMaterials_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="18" Width="28"/>
                                <TextBlock Text="Партии сырья" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnBatches" Click="Batches_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏭" FontSize="18" Width="28"/>
                                <TextBlock Text="Партии продукции" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        

                        <Button x:Name="btnHistory" Click="History_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📜" FontSize="18" Width="28"/>
                                <TextBlock Text="История испытаний" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnReports" Click="Reports_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="18" Width="28"/>
                                <TextBlock Text="Отчёты" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                
                
                
                <!-- Кнопка выхода -->
                <Border Grid.Row="2" Padding="0,15,0,25" BorderBrush="#2D2D3F" BorderThickness="0,1,0,0">
                    <Button x:Name="btnExit" Click="Exit_Click" Style="{StaticResource SideMenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="18" Width="28"/>
                            <TextBlock Text="Выйти" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Правая область контента -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель профиля -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceColor}" BorderBrush="#3F3F55" BorderThickness="0,0,0,1">
                <Grid Margin="25,12,25,12">
                    <TextBlock Text="лаборатория" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Background="#3F3F55" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblUser" Text="Лаборант" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Контент (Frame) -->
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="25,20,25,20" Background="Transparent"/>

            <!-- Статусбар -->
            <StatusBar Grid.Row="2" Background="#252536" Padding="15,5">
                <StatusBarItem>
                    <TextBlock x:Name="lblStatus" Text="✅ Система готова" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock Text="Агрохим · Система контроля качества" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>