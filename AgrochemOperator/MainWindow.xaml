<Window x:Class="AgrochemOperator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агрохим · Оператор" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#0F172A">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0EA5E9"/>

        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSideMenuButton" TargetType="Button" BasedOn="{StaticResource SideMenuButton}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccent}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="0,30" Background="#0F172A">
                    <StackPanel>
                        <TextBlock Text="⚙️" FontSize="40" Foreground="{StaticResource PrimaryAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="АГРОХИМ" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,5"/>
                        <TextBlock Text="оператор" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button x:Name="btnActiveBatches" Click="ActiveBatches_Click" Style="{StaticResource ActiveSideMenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏭" FontSize="18" Width="28"/>
                            <TextBlock Text="Активные партии" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Padding="0,15,0,25" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Button x:Name="btnExit" Click="Exit_Click" Style="{StaticResource SideMenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="18" Width="28"/>
                            <TextBlock Text="Выйти" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceColor}" BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid Margin="25,12,25,12">
                    <TextBlock Text="панель управления" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Background="#334155" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblUser" Text="Оператор" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="25,20,25,20" Background="Transparent"/>

            <StatusBar Grid.Row="2" Background="#0F172A" Padding="15,5">
                <StatusBarItem>
                    <TextBlock x:Name="lblStatus" Text="✅ Система готова" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>