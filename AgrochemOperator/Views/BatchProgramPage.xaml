<Window x:Class="AgrochemOperator.Views.BatchProgramPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Программа партии" Height="750" Width="1000"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="#0F172A">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📋 Программа партии" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="lblBatchInfo" Text="Партия: загрузка..." FontSize="14" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <!-- Панель текущего шага -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ТЕКУЩИЙ ШАГ" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="lblCurrentStep" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" Margin="0,5,0,5"/>
                    <TextBlock x:Name="lblStepInstruction" Text="Инструкция: " Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    <Border Background="#334155" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <TextBlock x:Name="lblPlannedParams" Text="Плановые параметры: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="ВВОД ФАКТИЧЕСКИХ ПАРАМЕТРОВ" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtActualParams" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="#334155" Foreground="{StaticResource TextPrimary}" BorderBrush="#475569"
                             Padding="10" Margin="0,10,0,10" FontSize="14"/>
                    <TextBlock Text="(Формат: параметр=значение; параметр2=значение2)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель телеметрии (видна только для шага "Экструзия") -->
        <Border x:Name="TelemetryPanel" Grid.Row="2" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="20" Margin="0,0,0,20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="📡 ТЕЛЕМЕТРИЯ ЭКСТРУДЕРА" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#334155" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Температура, °C" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="lblTemperature" Text="—" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}"/>
                            <TextBlock Text="Норма: 180-190" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#334155" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Давление, атм" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="lblPressure" Text="—" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}"/>
                            <TextBlock Text="Норма: 2.5-3.0" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#334155" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Скорость шнека, об/мин" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="lblSpeed" Text="—" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}"/>
                            <TextBlock Text="Норма: 120-150" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="lblTelemetryStatus" Text="⏳ Ожидание данных..." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список шагов -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ПОСЛЕДОВАТЕЛЬНОСТЬ ШАГОВ" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                <ListBox x:Name="listSteps" Grid.Row="1" ItemsSource="{Binding Steps}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="10,8" CornerRadius="8" Background="#2D3A4F">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OrderNum}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StepType}" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceColor}" CornerRadius="12" Padding="15" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnStartStep" Content="▶️ Начать шаг" Width="120" Height="40" Margin="0,0,15,0"
                        Background="{StaticResource PrimaryAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnStartStep_Click"/>
                <Button x:Name="btnCompleteStep" Content="✅ Завершить шаг" Width="140" Height="40" Margin="0,0,15,0"
                        Background="{StaticResource SuccessColor}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnCompleteStep_Click"/>
                <Button x:Name="btnDeviation" Content="⚠️ Отклонение" Width="120" Height="40"
                        Background="{StaticResource DangerColor}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnDeviation_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>