<Page x:Class="AgrochemOperator.Views.ActiveBatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Активные партии" Background="#0F172A" Height="594" Width="1200">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🏭 Активные партии" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC"/>
        <TextBlock Grid.Row="1" Text="Партии, запущенные в производство" FontSize="14" Foreground="#94A3B8" Margin="0,5,0,20"/>

        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="32"
                         Background="#334155" Foreground="#F8FAFC" BorderBrush="#475569" Padding="5"/>
                <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" Width="90" Height="32" Margin="10,0,0,0"
                        Background="#0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Batches}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectedItem="{Binding SelectedBatch}"
                  Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" RowHeight="45"
                  AlternatingRowBackground="#2D3A4F"
                  HeadersVisibility="Column">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E293B"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8FAFC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E293B"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8FAFC"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Номер партии" Binding="{Binding BatchNumber}" Width="150"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,193,0,0"
                BorderBrush="#334155" BorderThickness="1">
            <Button Content="▶️ Выбрать партию" Command="{Binding SelectBatchCommand}" Width="140" Height="34"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand"
                    IsEnabled="{Binding SelectedBatch, Converter={StaticResource ObjectToBoolean}}"/>
        </Border>
    </Grid>
</Page>