<Window x:Class="AgrochemApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агрохим" Height="595" Width="628"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- Стили для элементов -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="-31,0,0,4">
        <!-- Левая панель с логотипом -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть (зелёный градиент) -->
        <Border Grid.Column="0" Background="#0F766E" Margin="35,10,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <TextBlock Text="🌾" FontSize="64" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="АГРОХИМ" FontSize="28" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <TextBlock Text="Система управления производством" FontSize="14" 
                           Foreground="#E0E7FF" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="средств защиты растений" FontSize="14" 
                           Foreground="#E0E7FF" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <Line X1="0" Y1="0" X2="200" Y2="0" Stroke="White" StrokeThickness="1" 
                      Margin="0,30,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Технолог" FontSize="16" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Правая часть (форма входа/регистрации) -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="20,20,21,0">
            <Grid Margin="25,35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" x:Name="TitleText" Text="Вход в систему" 
                           FontSize="22" FontWeight="Bold" Foreground="#1F2937" 
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Поле Логин -->
                <TextBlock Grid.Row="1" Text="Логин" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                <TextBox Grid.Row="2" x:Name="txtUsername" Style="{StaticResource ModernTextBox}" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Поле Пароль -->
                <TextBlock Grid.Row="3" Text="Пароль" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                <PasswordBox Grid.Row="4" x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"/>

                <!-- Captcha панель (текстовая версия) -->
                <StackPanel Grid.Row="5" x:Name="CaptchaPanel" Visibility="Visible">
                    <TextBlock Text="Captcha" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="txtCaptchaCode" Text="1234" FontSize="18" FontWeight="Bold"
                   Background="#F3F4F6" Padding="15,10" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtCaptcha" Width="100" Height="35" VerticalAlignment="Center"
                 FontSize="14" TextAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1"/>
                        <Button Content="⟳" Width="40" Height="35" Margin="10,0" VerticalAlignment="Center"
                Background="#F3F4F6" BorderThickness="1" BorderBrush="#D1D5DB"
                Click="BtnRefreshCaptcha_Click" FontSize="16"/>
                    </StackPanel>
                </StackPanel>

                <!-- Панель регистрации (скрыта по умолчанию) -->
                <StackPanel Grid.Row="5" x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="ФИО" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFullName" Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Email" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Роль" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbRole" Height="40" Margin="0,5,0,15" SelectedIndex="0">
                        <ComboBoxItem Content="technologist"/>
                        <ComboBoxItem Content="operator"/>
                        <ComboBoxItem Content="laboratory"/>
                    </ComboBox>

                    <TextBlock Text="Отдел" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDepartment" Text="Технологический отдел" 
                             Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <!-- Ошибка -->
                <TextBlock Grid.Row="6" x:Name="lblError" Foreground="#EF4444" FontSize="12" 
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,5"/>

                <!-- Кнопка действия -->
                <Button Grid.Row="7" x:Name="btnAction" Content="ВОЙТИ" 
                        Style="{StaticResource PrimaryButton}" Margin="0,10,0,10" Click="BtnLogin_Click"/>

                <!-- Переключатель между входом и регистрацией -->
                <TextBlock Grid.Row="8" TextAlignment="Center" FontSize="12" Margin="0,5,0,0">
                    <Hyperlink x:Name="lnkSwitch" Click="LnkSwitch_Click" Foreground="#3B82F6">
                        <Run x:Name="linkText" Text="Нет аккаунта? Зарегистрироваться"/>
                        
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>