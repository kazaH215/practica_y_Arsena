<Page x:Class="AgrochemApp.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Продукция" Background="#F8FAFC">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Продукция" FontSize="22" FontWeight="SemiBold" 
                       Foreground="#0F172A"/>
            <TextBlock Text="Управление номенклатурой продукции" FontSize="13" 
                       Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Панель инструментов -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" Height="32" Padding="8,5"/>
                <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" 
                        Width="90" Height="32" Margin="10,0,0,0"
                        Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="⏳ Загрузка данных..." HorizontalAlignment="Center" Foreground="#64748B"/>
        </Border>

        <!-- Таблица продуктов -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectedItem="{Binding SelectedProduct}"
                  Background="White" BorderBrush="#E2E8F0" RowHeight="45"
                  FontSize="13" AlternatingRowBackground="#F8FAFC"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibility}}">

            <DataGrid.Resources>
                <!-- Стиль для ячеек -->
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="12,0"/>
                </Style>

                <!-- Стиль для заголовков -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="12,0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#3B82F6"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Форма выпуска" Binding="{Binding Form}" Width="120"/>

                <!-- Статус с цветным индикатором -->
                <DataGridTemplateColumn Header="Статус" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="20" Padding="8,4" 
                                    Background="{Binding Status, Converter={StaticResource StatusToColor}}">
                                <TextBlock Text="{Binding Status}" Foreground="White" 
                                           FontSize="11" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Сообщение "нет данных" -->
        <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="12" Padding="30"
                Visibility="{Binding HasNoData, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="📭 Нет данных о продукции" 
                       HorizontalAlignment="Center" Foreground="#64748B" FontSize="14"/>
        </Border>
    </Grid>
</Page>