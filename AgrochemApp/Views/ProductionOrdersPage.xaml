<Page x:Class="AgrochemApp.Views.ProductionOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Производственные заказы" Background="#F8FAFC">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📄 Производственные заказы" FontSize="22" FontWeight="SemiBold" 
                       Foreground="#0F172A"/>
            <TextBlock Text="Управление производственными заказами" FontSize="13" 
                       Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Панель инструментов -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" Height="32" Padding="8,5"/>
                <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" 
                        Width="90" Height="32" Margin="10,0,0,0"
                        Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="➕ Создать заказ" Command="{Binding CreateCommand}" 
                        Width="120" Height="32" Margin="10,0,0,0"
                        Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="12" Padding="15" Margin="0,0,0,20"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="⏳ Загрузка данных..." HorizontalAlignment="Center" Foreground="#64748B"/>
        </Border>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectedItem="{Binding SelectedOrder}"
                  Background="White" BorderBrush="#E2E8F0" RowHeight="40"
                  FontSize="13" AlternatingRowBackground="#F8FAFC"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibility}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="200"/>
                <DataGridTextColumn Header="Кол-во (кг)" Binding="{Binding PlannedQty}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Партий" Binding="{Binding BatchCount}" Width="70"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Сообщение "нет данных" -->
        <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="12" Padding="30"
                Visibility="{Binding HasNoData, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="📭 Нет данных. Нажмите 'Создать заказ'." 
                       HorizontalAlignment="Center" Foreground="#64748B" FontSize="14"/>
        </Border>

        <!-- Панель действий -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="15" Margin="0,15,0,0"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="❌ Отменить заказ" Command="{Binding CancelCommand}" 
                        Width="120" Height="34" Background="#EF4444" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"
                        IsEnabled="{Binding SelectedOrder, Converter={StaticResource ObjectToBoolean}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>