<Window x:Class="AgrochemApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агрохим - Технолог" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <!-- Стиль для кнопок бокового меню -->
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для активной кнопки -->
        <Style x:Key="ActiveSideMenuButton" TargetType="Button" BasedOn="{StaticResource SideMenuButton}">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>

        <!-- Стиль для карточки дашборда -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== ЛЕВАЯ ПАНЕЛЬ ========== -->
        <Border Grid.Column="0" Background="#1E293B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Border Grid.Row="0" Padding="0,30" Background="#0F172A">
                    <StackPanel>
                        <TextBlock Text="🌾" FontSize="36" Foreground="#10B981" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="АГРОХИМ" FontSize="22" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,5"/>
                        <TextBlock Text="Модуль технолога" FontSize="12" 
                                   Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Меню навигации -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" Margin="0,15,0,0">
                    <StackPanel>
                        <Button x:Name="btnDashboard" Click="Dashboard_Click" 
                                Style="{StaticResource ActiveSideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="18" Width="28"/>
                                <TextBlock Text="Панель управления" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnProducts" Click="Products_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="18" Width="28"/>
                                <TextBlock Text="Продукция" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnRecipes" Click="Recipes_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖" FontSize="18" Width="28"/>
                                <TextBlock Text="Рецептуры" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnTechCards" Click="TechCards_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="18" Width="28"/>
                                <TextBlock Text="Технологические карты" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnOrders" Click="Orders_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="18" Width="28"/>
                                <TextBlock Text="Производственные заказы" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnBatches" Click="Batches_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏭" FontSize="18" Width="28"/>
                                <TextBlock Text="Производственные партии" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnExtruder" Click="Extruder_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="18" Width="28"/>
                                <TextBlock Text="Программы экструдера" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnDeviations" Click="Deviations_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="18" Width="28"/>
                                <TextBlock Text="Отклонения и события" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnReports" Click="Reports_Click" Style="{StaticResource SideMenuButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="18" Width="28"/>
                                <TextBlock Text="Отчёты" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Нижняя панель с выходом -->
                <Border Grid.Row="2" Padding="0,15,0,20" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Button x:Name="btnExit" Click="Exit_Click" Style="{StaticResource SideMenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="18" Width="28"/>
                            <TextBlock Text="Выйти" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ========== ПРАВАЯ ПАНЕЛЬ ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель профиля -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="25,12,25,12">
                    <TextBlock Text="Панель управления" FontSize="18" FontWeight="SemiBold" 
                               Foreground="#1E293B" VerticalAlignment="Center"/>

                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#F1F5F9" 
                            CornerRadius="20" Padding="12,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblUser" Text="Иванов И.П. (технолог)" 
                                       Foreground="#334155" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Контент -->
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="25,20,25,20"/>

            <!-- Нижняя строка статуса -->
            <StatusBar Grid.Row="2" Background="#F8FAFC" Height="32">
                <StatusBarItem>
                    <TextBlock x:Name="lblStatus" Text="✅ Система готова к работе" 
                               Foreground="#475569" FontSize="12"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock Text="🔷 Агрохим - Система управления производством СЗР" 
                               Foreground="#64748B" FontSize="11"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="📅 Вход выполнен: технолог" 
                               Foreground="#64748B" FontSize="11"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>