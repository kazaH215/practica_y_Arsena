              "mode": "raw",
              "raw": "{\n  \"username\": \"new.operator\",\n  \"fullName\": \"Новый Оператор\",\n  \"email\": \"operator@test.ru\",\n  \"password\": \"123\",\n  \"role\": \"operator\",\n  \"department\": \"Цех №1\"\n}"
